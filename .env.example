APP_NAME=SI-LEMBUR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# Alamat IP atau CIDR proxy tepercaya, dipisah koma. Kosongkan bila akses langsung.
TRUSTED_PROXIES=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev lokal: MySQL 8 lewat `docker compose up -d` (lihat docker-compose.yml).
# Produksi: kredensial MySQL/MariaDB dari hPanel Hostinger.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=si_lembur
DB_USERNAME=si_lembur
DB_PASSWORD=secret

# Tanpa Redis dan queue worker (shared hosting).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Password akun contoh dari seeder (dev saja). Wajib diisi di luar local/testing.
SEED_DEFAULT_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
